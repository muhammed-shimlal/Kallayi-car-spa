// ==============================================================================
// KALLAYI CAR SPA & AUTO CARE - PRISMA SCHEMA DEFINITION
// Dynamic Vehicle-Body-Type-Based Pricing Matrix Specification
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum VehicleType {
  HATCHBACK
  SEDAN
  COMPACT_SUV
  FULL_SUV
  SUV
  MUV
  VAN
  LUXURY
  TWO_WHEELER
  BIKE
  AUTO
  TRUCK
}

enum BookingStatus {
  PENDING
  CONFIRMED
  WAITING
  IN_BAY_1
  IN_BAY_2
  DETAILING
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Service {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(100)
  description      String             @default("") @db.Text
  icon_url         String?            @default("") @db.Text
  is_active        Boolean            @default(true)
  base_price       Decimal            @default(0.00) @db.Decimal(10, 2)
  duration_minutes Int                @default(60)
  vehicle_type     String             @default("ALL") @db.VarChar(20)
  chemical_recipe  Json               @default("{}")
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  // Relationships
  tier_prices      ServiceTierPrice[]
  bookings         Booking[]

  @@map("service_packages")
}

model ServiceTierPrice {
  id                     Int         @id @default(autoincrement())
  service_id             Int         @map("package_id")
  vehicle_type           VehicleType
  price                  Decimal     @db.Decimal(10, 2)
  estimated_time_minutes Int?        @default(45)

  // Relationships
  service                Service     @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([service_id, vehicle_type], name: "uq_service_vehicle_type")
  @@map("service_package_prices")
}

model CustomerVehicle {
  id                  Int          @id @default(autoincrement())
  user_id             String?      @db.Uuid
  make                String       @db.VarChar(50)
  model               String       @db.VarChar(50)
  plate_number        String       @unique @db.VarChar(20)
  registration_number String       @default("") @db.VarChar(50)
  color               String       @default("") @db.VarChar(30)
  year                Int?
  notes               String       @default("") @db.Text
  vehicle_type        VehicleType  @default(HATCHBACK)
  created_at          DateTime     @default(now()) @db.Timestamptz(6)

  // Relationships
  bookings            Booking[]

  @@map("customer_vehicles")
}

model Booking {
  id                 Int              @id @default(autoincrement())
  customer_id        String           @db.Uuid
  vehicle_id         Int
  technician_id      String?          @db.Uuid
  service_package_id Int?
  time_slot          DateTime         @db.Timestamptz(6)
  end_time           DateTime?        @db.Timestamptz(6)
  start_time         DateTime?        @db.Timestamptz(6)
  status             BookingStatus    @default(PENDING)
  bay_assignment     String?          @db.VarChar(50)
  base_price         Decimal          @default(0.00) @db.Decimal(10, 2)
  final_price        Decimal          @default(0.00) @db.Decimal(10, 2)
  discount_amount    Decimal          @default(0.00) @db.Decimal(10, 2)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)

  // Relationships
  service            Service?         @relation(fields: [service_package_id], references: [id], onDelete: SetNull)
  vehicle            CustomerVehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@map("bookings")
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
}

model BankTransaction {
  id               Int                 @id @default(autoincrement())
  amount           Decimal             @db.Decimal(12, 2)
  transaction_type BankTransactionType
  bank_name        String              @default("Primary Bank Account") @db.VarChar(100)
  purpose          String              @default("") @db.Text
  reference_number String?             @db.VarChar(100)
  receipt_image    String?             @db.Text
  recorded_by_id   String?             @db.Uuid
  recorded_by_name String?             @default("Admin Manager") @db.VarChar(100)
  transaction_date DateTime            @default(now()) @db.Timestamptz(6)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([transaction_date(sort: Desc)])
  @@index([transaction_type])
  @@map("bank_transactions")
}

model StaffAdvance {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id   String    @db.Uuid
  amount     Decimal   @db.Decimal(10, 2)
  date       DateTime  @default(now()) @db.Timestamptz(6)
  purpose    String    @default("Staff Advance") @db.Text
  is_settled Boolean   @default(false)
  settled_at DateTime? @db.Timestamptz(6)
  payout_id  BigInt?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([staff_id, is_settled])
  @@index([date(sort: Desc)])
  @@map("staff_advances")
}

model StaffCashHandover {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id                  String   @db.Uuid
  amount                    Decimal  @db.Decimal(10, 2)
  notes                     String?  @default("") @db.Text
  vehicle_summary           String?  @default("") @db.Text
  reconciled_invoices_count Int      @default(0)
  handover_date             DateTime @default(now()) @db.Timestamptz(6)
  received_by_user_id       String?  @db.Uuid
  created_at                DateTime @default(now()) @db.Timestamptz(6)

  @@index([staff_id])
  @@index([handover_date(sort: Desc)])
  @@map("staff_cash_handovers")
}


