# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file to version control

SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# Database
# For SQLite (default locally):
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/kallayi_db

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app

# Next.js Frontend URL for Password Reset Link
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Automated Superuser Deployment Setup (used by python manage.py setup_admin)
DJANGO_SUPERUSER_EMAIL=admin@kallayicarspa.com
DJANGO_SUPERUSER_PASSWORD=your_secure_production_password_here
DJANGO_SUPERUSER_USERNAME=admin

# SMTP Email Configuration (Gmail / Custom SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=Kallayi Car Spa <your_email@gmail.com>

# Cloudinary Media Storage (Optional for persistent cloud media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
