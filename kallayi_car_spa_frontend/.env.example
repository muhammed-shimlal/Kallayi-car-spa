# ==============================================================================
# KALLAYI CAR SPA & AUTO CARE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy these keys into your Vercel Project Settings -> Environment Variables.
# 
# Client-side variables (prefixed with NEXT_PUBLIC_) are bundled into the browser.
# Server-side variables (WITHOUT NEXT_PUBLIC_) remain strictly isolated on serverless routes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE NEXT.JS & SITE URLS (Client & Server)
# ------------------------------------------------------------------------------
# In production, set NEXT_PUBLIC_SITE_URL to your custom domain or Vercel URL
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_SITE_URL=https://kallayicarspa.com

# ------------------------------------------------------------------------------
# 2. UPI PAYMENT QR CONFIGURATION (Counter Checkout)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_UPI_ID=kabeerkallayi2020-1@oksbi
NEXT_PUBLIC_MERCHANT_NAME="Kallayi Car Spa"

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [CRITICAL SECURITY] Server-Side Service Role Key (NEVER prefix with NEXT_PUBLIC_)
# Bypasses Row Level Security for admin route handlers & background workers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. GEMINI AI AGENT & MODEL CONTEXT PROTOCOL (MCP) INTEGRATION
# ------------------------------------------------------------------------------
# Secret Bearer token for authenticating AI automation requests (/api/ai/*)
# Generate a strong 32+ character random string in production
AI_SECRET_KEY=your_secure_random_ai_bearer_token_here

# ------------------------------------------------------------------------------
# 5. WHATSAPP NOTIFICATION BRIDGE (Optional / Microservice)
# ------------------------------------------------------------------------------
# Local bridge or remote webhook URL for Baileys/WhatsApp automation
WHATSAPP_BRIDGE_URL=http://localhost:3005
